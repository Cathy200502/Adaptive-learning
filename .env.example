# Backend
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/adaptive_learning
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Adaptive engine (all optional - defaults shown)
ADAPTIVE_PROMOTE_STREAK=1
ADAPTIVE_DEMOTE_STREAK=1
MASTERY_GAIN=10
MASTERY_PENALTY=5
MASTERY_THRESHOLD=80
MASTERY_MIN_ATTEMPTS=5
MASTERY_MIN_ACCURACY=0.7
MASTERY_REQUIRE_MEDIUM=true
MASTERY_MEDIUM_CORRECT=2
ADAPTIVE_RECENT_WINDOW=3

# Gemini AI - question generation only (admin > Manage questions)
# Get a key at https://aistudio.google.com/apikey and put it in backend/.env
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend (frontend/.env)
VITE_API_URL=http://localhost:5000/api
